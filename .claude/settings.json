{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/loop_guard.py\"",
            "timeout": 10,
            "statusMessage": "Loop-Guard"
          }
        ]
      }
    ]
  }
}
